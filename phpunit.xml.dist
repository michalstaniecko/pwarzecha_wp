<?xml version="1.0"?>
<!--
	Two suites (#37, ADR 0011):
	- unit: tests/php/unit, Brain Monkey, no WordPress. Default suite (plain `vendor/bin/phpunit`).
	- integration: tests/php/integration, WP test suite. Needs a WordPress: run it through
	  `npm run test:php` (Playground) or `npm run test:php:mariadb` (wp-env, #38).
	PHPUnit 9.6: the WP 7.1 test suite does not run on PHPUnit 10+ (see tests/README.md).
-->
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
	bootstrap="tests/php/bootstrap.php"
	defaultTestSuite="unit"
	colors="true"
	cacheResult="false"
	beStrictAboutTestsThatDoNotTestAnything="true"
	beStrictAboutOutputDuringTests="true"
	convertDeprecationsToExceptions="true"
	failOnRisky="true"
	failOnWarning="true"
>
	<testsuites>
		<testsuite name="unit">
			<directory suffix="Test.php">tests/php/unit</directory>
		</testsuite>
		<testsuite name="integration">
			<directory suffix="Test.php">tests/php/integration</directory>
		</testsuite>
	</testsuites>
</phpunit>
