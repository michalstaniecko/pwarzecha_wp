{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Biały", "color": "#ffffff" },
				{ "slug": "contrast", "name": "Tekst", "color": "#0e1626" },
				{ "slug": "primary", "name": "Granat", "color": "#11213b" },
				{
					"slug": "primary-dark",
					"name": "Granat ciemny",
					"color": "#0a1528"
				},
				{
					"slug": "primary-light",
					"name": "Granat jasny",
					"color": "#24395c"
				},
				{ "slug": "accent", "name": "Pomarańcz", "color": "#e39650" },
				{
					"slug": "accent-light",
					"name": "Pomarańcz jasny",
					"color": "#f2b47a"
				},
				{
					"slug": "accent-dark",
					"name": "Pomarańcz ciemny",
					"color": "#a4520f"
				},
				{
					"slug": "neutral-100",
					"name": "Szary 100",
					"color": "#f4f6f9"
				},
				{
					"slug": "neutral-300",
					"name": "Szary 300",
					"color": "#cdd4de"
				},
				{
					"slug": "neutral-600",
					"name": "Szary 600",
					"color": "#4f5a6a"
				},
				{ "slug": "success", "name": "Tak", "color": "#1f7a4c" },
				{ "slug": "danger", "name": "Nie", "color": "#b42318" },
				{
					"slug": "overlay",
					"name": "Nakładka",
					"color": "rgba(10, 21, 40, 0.72)"
				},
				{
					"slug": "overlay-soft",
					"name": "Nakładka lekka",
					"color": "rgba(10, 21, 40, 0.2)"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fluid": {
				"minViewportWidth": "375px",
				"maxViewportWidth": "1440px"
			},
			"fontFamilies": [
				{
					"slug": "archivo",
					"name": "Archivo",
					"fontFamily": "\"Archivo\", \"Arial Black\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Archivo",
							"fontStyle": "normal",
							"fontWeight": "600 800",
							"fontStretch": "100% 125%",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/archivo-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Archivo",
							"fontStyle": "normal",
							"fontWeight": "600 800",
							"fontStretch": "100% 125%",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/archivo-latin-ext.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"slug": "source-sans-3",
					"name": "Source Sans 3",
					"fontFamily": "\"Source Sans 3\", \"Segoe UI\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Source Sans 3",
							"fontStyle": "normal",
							"fontWeight": "400 600",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-sans-3-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Source Sans 3",
							"fontStyle": "normal",
							"fontWeight": "400 600",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/source-sans-3-latin-ext.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Mały",
					"size": "1rem",
					"fluid": { "min": "0.9375rem", "max": "1rem" }
				},
				{
					"slug": "medium",
					"name": "Średni",
					"size": "1.125rem",
					"fluid": { "min": "1.0625rem", "max": "1.125rem" }
				},
				{
					"slug": "large",
					"name": "Duży",
					"size": "1.375rem",
					"fluid": { "min": "1.1875rem", "max": "1.375rem" }
				},
				{
					"slug": "x-large",
					"name": "Bardzo duży",
					"size": "1.75rem",
					"fluid": { "min": "1.375rem", "max": "1.75rem" }
				},
				{
					"slug": "xx-large",
					"name": "H2",
					"size": "2.5rem",
					"fluid": { "min": "1.75rem", "max": "2.5rem" }
				},
				{
					"slug": "xxx-large",
					"name": "H1",
					"size": "3.5rem",
					"fluid": { "min": "2.125rem", "max": "3.5rem" }
				}
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "2XS", "size": "8px" },
				{ "slug": "30", "name": "XS", "size": "12px" },
				{ "slug": "40", "name": "S", "size": "20px" },
				{
					"slug": "50",
					"name": "M",
					"size": "clamp(1.5rem, 1.3239rem + 0.7512vw, 2rem)"
				},
				{
					"slug": "60",
					"name": "L",
					"size": "clamp(2rem, 1.6479rem + 1.5023vw, 3rem)"
				},
				{
					"slug": "70",
					"name": "XL",
					"size": "clamp(2.5rem, 1.7958rem + 3.0047vw, 4.5rem)"
				},
				{
					"slug": "80",
					"name": "2XL",
					"size": "clamp(3.5rem, 2.2676rem + 5.2582vw, 7rem)"
				}
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "card",
					"name": "Karta",
					"shadow": "0 1px 2px rgba(14, 22, 38, 0.06), 0 4px 16px rgba(14, 22, 38, 0.08)"
				},
				{
					"slug": "raised",
					"name": "Uniesienie",
					"shadow": "0 12px 32px rgba(14, 22, 38, 0.18)"
				}
			]
		},
		"blocks": {
			"core/image": {
				"lightbox": { "enabled": false, "allowEditing": false }
			},
			"core/gallery": {
				"lightbox": { "enabled": false, "allowEditing": false }
			}
		},
		"custom": {
			"radius": {
				"small": "4px",
				"medium": "8px",
				"full": "999px"
			},
			"border": {
				"hairline": "1px",
				"control": "2px",
				"accent": "3px",
				"focus": "3px"
			},
			"ratio": {
				"wide": "16 / 9",
				"photo": "4 / 3",
				"square": "1 / 1"
			},
			"hero-min-height-large": "620px",
			"spacing": {
				"10": "4px"
			},
			"size": {
				"target": "48px",
				"target-compact": "44px",
				"icon-small": "16px",
				"icon": "20px",
				"icon-large": "28px",
				"icon-box": "56px",
				"rule": "32px"
			},
			"offset": {
				"underline": "3px",
				"underline-large": "4px",
				"focus": "3px"
			},
			"prose": {
				"flow": "1em",
				"quote-flow": "0.6em",
				"list-indent": "1.2em",
				"list-indent-ordered": "1.4em"
			},
			"typography": {
				"h1": {
					"fontFamily": "var(--wp--preset--font-family--archivo)",
					"fontSize": "var(--wp--preset--font-size--xxx-large)",
					"fontWeight": 800,
					"lineHeight": 1.08,
					"letterSpacing": "0.03em"
				},
				"h2": {
					"fontFamily": "var(--wp--preset--font-family--archivo)",
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": 800,
					"lineHeight": 1.12,
					"letterSpacing": "0.03em"
				},
				"h3": {
					"fontFamily": "var(--wp--preset--font-family--archivo)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": 700,
					"lineHeight": 1.25
				},
				"h4": {
					"fontFamily": "var(--wp--preset--font-family--archivo)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": 700,
					"lineHeight": 1.3
				},
				"eyebrow": {
					"fontFamily": "var(--wp--preset--font-family--archivo)",
					"fontSize": "0.9375rem",
					"fontWeight": 700,
					"lineHeight": 1.4,
					"letterSpacing": "0.14em"
				},
				"button": {
					"fontFamily": "var(--wp--preset--font-family--archivo)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": 700,
					"lineHeight": 1.2,
					"letterSpacing": "0.06em"
				},
				"lead": {
					"fontFamily": "var(--wp--preset--font-family--source-sans-3)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": 400,
					"lineHeight": 1.5
				},
				"body": {
					"fontFamily": "var(--wp--preset--font-family--source-sans-3)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": 400,
					"lineHeight": 1.65
				},
				"body-strong": {
					"fontFamily": "var(--wp--preset--font-family--source-sans-3)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": 600,
					"lineHeight": 1.65
				},
				"badge": {
					"fontFamily": "var(--wp--preset--font-family--archivo)",
					"fontSize": "0.8125rem",
					"fontWeight": 700,
					"lineHeight": 1.4,
					"letterSpacing": "0.08em"
				},
				"meta": {
					"fontFamily": "var(--wp--preset--font-family--source-sans-3)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": 400,
					"lineHeight": 1.5
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--custom--typography--body--font-family)",
			"fontSize": "var(--wp--custom--typography--body--font-size)",
			"fontWeight": "var(--wp--custom--typography--body--font-weight)",
			"lineHeight": "var(--wp--custom--typography--body--line-height)"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--sp-heading)"
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--custom--typography--h-1--font-family)",
					"fontSize": "var(--wp--custom--typography--h-1--font-size)",
					"fontWeight": "var(--wp--custom--typography--h-1--font-weight)",
					"lineHeight": "var(--wp--custom--typography--h-1--line-height)",
					"letterSpacing": "var(--wp--custom--typography--h-1--letter-spacing)",
					"textTransform": "uppercase"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--custom--typography--h-2--font-family)",
					"fontSize": "var(--wp--custom--typography--h-2--font-size)",
					"fontWeight": "var(--wp--custom--typography--h-2--font-weight)",
					"lineHeight": "var(--wp--custom--typography--h-2--line-height)",
					"letterSpacing": "var(--wp--custom--typography--h-2--letter-spacing)",
					"textTransform": "uppercase"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--custom--typography--h-3--font-family)",
					"fontSize": "var(--wp--custom--typography--h-3--font-size)",
					"fontWeight": "var(--wp--custom--typography--h-3--font-weight)",
					"lineHeight": "var(--wp--custom--typography--h-3--line-height)"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--custom--typography--h-4--font-family)",
					"fontSize": "var(--wp--custom--typography--h-4--font-size)",
					"fontWeight": "var(--wp--custom--typography--h-4--font-weight)",
					"lineHeight": "var(--wp--custom--typography--h-4--line-height)"
				}
			},
			"link": {
				"color": {
					"text": "var(--sp-link)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--sp-link-hover)"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var(--sp-focus)",
						"offset": "var(--wp--custom--offset--focus)",
						"style": "solid",
						"width": "var(--wp--custom--border--focus)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--primary)"
				},
				"border": {
					"color": "transparent",
					"radius": "var(--wp--custom--radius--small)",
					"style": "solid",
					"width": "var(--wp--custom--border--control)"
				},
				"spacing": {
					"padding": {
						"top": "0",
						"bottom": "0",
						"left": "var(--wp--preset--spacing--40)",
						"right": "var(--wp--preset--spacing--40)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--custom--typography--button--font-family)",
					"fontSize": "var(--wp--custom--typography--button--font-size)",
					"fontWeight": "var(--wp--custom--typography--button--font-weight)",
					"lineHeight": "var(--wp--custom--typography--button--line-height)",
					"letterSpacing": "var(--wp--custom--typography--button--letter-spacing)",
					"textTransform": "uppercase"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-light)",
						"text": "var(--wp--preset--color--primary)"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var(--sp-focus)",
						"offset": "var(--wp--custom--offset--focus)",
						"style": "solid",
						"width": "var(--wp--custom--border--focus)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--sp-muted)"
				},
				"typography": {
					"fontSize": "var(--wp--custom--typography--meta--font-size)",
					"lineHeight": "var(--wp--custom--typography--meta--line-height)"
				},
				"spacing": {
					"margin": {
						"top": "var(--wp--preset--spacing--20)",
						"bottom": "0"
					}
				}
			}
		},
		"blocks": {
			"core/post-date": {
				"color": {
					"text": "var(--sp-muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/query-pagination": {
				"spacing": {
					"margin": {
						"top": "var(--wp--preset--spacing--60)"
					},
					"blockGap": "var(--wp--preset--spacing--20)"
				},
				"typography": {
					"fontWeight": "600"
				}
			},
			"core/quote": {
				"spacing": {
					"margin": {
						"top": "var(--wp--preset--spacing--60)",
						"bottom": "var(--wp--preset--spacing--60)"
					}
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "1.45"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
