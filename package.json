{
  "name": "pwarzecha-wp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.13"
    },
    "packageManager": {
      "name": "npm"
    }
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "npm run icons && wp-scripts build --webpack-src-dir=theme/src/blocks",
    "start": "npm run icons && wp-scripts start --webpack-src-dir=theme/src/blocks",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:php && npm run lint:phpstan && npm run lint:theme-json",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "wp-scripts lint-style --allow-empty-input",
    "lint:php": "mkdir -p .cache && vendor/bin/phpcs",
    "lint:phpstan": "vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
    "lint:theme-json": "ajv validate --spec=draft7 --strict=false -c ajv-formats --errors=text -s tools/schemas/theme.json -d theme/theme.json",
    "tokens:check": "node tools/ds/theme-to-tokens.mjs --check theme/theme.json tools/ds/fixtures/ds-tokens.json",
    "tokens:map": "node tools/ds/theme-map.mjs > tools/ds/theme-map.json",
    "test:tools": "node --test tools/",
    "test:js": "wp-scripts test-unit-js --passWithNoTests",
    "test:php:unit": "vendor/bin/phpunit --testsuite unit",
    "test:php": "npm run test:php:unit && node tools/playground/phpunit.mjs",
    "test:php:mariadb": "node tools/env/wp-env.mjs test:php",
    "test:e2e": "npm run build && playwright test",
    "test:visual": "echo 'brak – wypełnia #42' && exit 0",
    "test:visual:update": "echo 'brak – wypełnia #42' && exit 0",
    "test:lighthouse": "echo 'brak – wypełnia #94' && exit 0",
    "check": "npm run lint && npm run tokens:check && npm run icons -- --check && npm run test:tools && npm run test:js && npm run test:php",
    "check:full": "npm run check && npm run test:php:mariadb && npm run test:e2e:all && npm run test:visual && npm run test:lighthouse",
    "env:status": "node tools/env/env.mjs status",
    "env:clean": "node tools/env/env.mjs clean",
    "env:start": "node tools/env/wp-env.mjs start",
    "env:stop": "node tools/env/wp-env.mjs stop",
    "env:reset": "node tools/env/wp-env.mjs reset",
    "env:cli": "node tools/env/wp-env.mjs cli",
    "db:export": "node tools/env/wp-env.mjs db:export",
    "db:import": "node tools/env/wp-env.mjs db:import",
    "seed": "node tools/env/wp-env.mjs seed",
    "test:e2e:wp-env": "node tools/env/wp-env.mjs test:e2e",
    "test:e2e:all": "PW_E2E_PLUGINS=1 npm run test:e2e",
    "wp:playground": "node tools/playground/server.mjs",
    "icons": "node tools/icons/sync-icons.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "1.65.1",
    "@wordpress/components": "^45.0.0",
    "@wordpress/e2e-test-utils-playwright": "^3.3.0",
    "@wordpress/element": "^10.2.0",
    "@wordpress/env": "^12.2.0",
    "@wordpress/eslint-plugin": "^28.2.0",
    "@wordpress/hooks": "^5.2.0",
    "@wordpress/i18n": "^7.2.0",
    "@wordpress/scripts": "^37.2.0",
    "@wordpress/stylelint-config": "^27.2.0",
    "@wp-playground/cli": "^3.1.66",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.16.0",
    "lefthook": "^2.2.4",
    "lucide-static": "^1.82.0",
    "picomatch": "^2.3.2",
    "simple-icons": "^16.38.1",
    "stylelint": "^17.16.0",
    "vitest": "^5.1.2",
    "yaml": "^2.9.1"
  }
}
