{
	"name": "pwarzecha/pwarzecha-wp",
	"description": "Motyw blokowy i narzędzia strony zajęć Przemka (PHP tooling, pinned plugins).",
	"type": "project",
	"license": "proprietary",
	"repositories": [
		{
			"type": "composer",
			"url": "https://wpackagist.org",
			"only": [
				"wpackagist-plugin/*",
				"wpackagist-theme/*"
			]
		}
	],
	"require": {
		"php": ">=8.4",
		"composer/installers": "^2.3",
		"wpackagist-plugin/cookie-law-info": "^3.5",
		"wpackagist-plugin/wordpress-seo": "^28.9"
	},
	"require-dev": {
		"brain/monkey": "^2.8",
		"php-stubs/wp-cli-stubs": "^2.12",
		"phpcompatibility/phpcompatibility-wp": "^2.1.8",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.3",
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.13.5",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.4",
		"wp-phpunit/wp-phpunit": "^7.1",
		"wpackagist-plugin/theme-check": "20260901",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"config": {
		"platform": {
			"php": "8.4"
		},
		"sort-packages": true,
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"extra": {
		"installer-paths": {
			".wp/plugins/{$name}/": [
				"type:wordpress-plugin"
			]
		}
	},
	"scripts": {
		"lint:php": "phpcs",
		"lint:phpstan": "phpstan analyse --memory-limit=1G"
	}
}
